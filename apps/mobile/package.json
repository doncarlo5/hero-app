{
  "name": "hero-app-mobile",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "packageManager": "npm@10.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
