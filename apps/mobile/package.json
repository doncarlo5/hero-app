  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/aes-js": "^3.1.4",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "prettier": "^3.5.3",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@supabase/supabase-js"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@rneui/base",
          "@rneui/themed",
          "aes-js",
          "ajv",
          "ajv-keywords"
