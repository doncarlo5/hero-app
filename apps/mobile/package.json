{
  "name": "hero-app-mobile",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "packageManager": "npm@10.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-colors": "node ./scripts/generate-colors.js && eslint ./constants/colors.ts --fix",
    "postinstall": "cd ../.. && npm run build"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.0.1",
    "@legendapp/list": "^2.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-picker/picker": "2.11.4",
    "@rn-primitives/label": "^1.1.0",
    "@rn-primitives/radio-group": "^1.1.0",
    "@rn-primitives/slot": "^1.1.0",
    "@rn-primitives/switch": "^1.1.0",
    "@rn-primitives/types": "^1.1.0",
    "@supabase/supabase-js": "^2.50.0",
    "@tanstack/react-query": "^5.104.2",
    "aes-js": "^3.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "expo": "^57.0.9",
    "expo-apple-authentication": "~57.0.2",
    "expo-audio": "~57.0.5",
    "expo-auth-session": "~57.0.16",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^0.312.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.55.0",
    "react-native": "0.86.3",
    "react-native-countdown-circle-timer": "^3.2.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "~3.4.17",
    "victory-native": "^37.3.6",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/aes-js": "^3.1.4",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "prettier": "^3.5.3",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@supabase/supabase-js"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@rneui/base",
          "@rneui/themed",
          "aes-js",
          "ajv",
          "ajv-keywords"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "private": true
}
