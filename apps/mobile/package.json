    "@tanstack/react-query": "^5.104.2",
    "aes-js": "^3.1.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "expo": "^57.0.9",
    "expo-apple-authentication": "~57.0.2",
    "expo-audio": "~57.0.5",
    "expo-auth-session": "~57.0.16",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
