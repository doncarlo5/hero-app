# Hero App — environment template (monorepo root)
# Copy to .env and fill in. Every app reads this single file:
#   - apps/api: config/load-env.js
#   - apps/web: Vite envDir points to the root
#   - apps/mobile: Expo only reads its own folder, so link it once:
#       ln -s ../../.env apps/mobile/.env
# In production, values come from Vercel (api, web) and EAS environment variables (mobile).

# --- Supabase (shared) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- API (apps/api) ---
NODE_ENV=development
PORT=3000
# mongodb+srv://<user>:<password>@<cluster>/<db>
MONGODB_URI=
FRONTEND_ORIGIN_URL=

# --- Web (apps/web, VITE_ prefix) ---
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
VITE_BACKEND_URL=

# --- Mobile (apps/mobile, EXPO_PUBLIC_ prefix) ---
EXPO_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
EXPO_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
EXPO_PUBLIC_BASE_URL=
