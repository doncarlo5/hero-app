# Hero App — modèle de .env (racine du monorepo)
# Copier en .env et remplir. apps/mobile/.env est un lien symbolique vers ce fichier (ln -s ../../.env apps/mobile/.env).
# En production, les valeurs viennent de Vercel (API, web) et EAS (mobile).

# --- Supabase (commun) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- API (apps/api) ---
NODE_ENV=development
PORT=3000
# mongodb+srv://<user>:<password>@<cluster>/<db>
MONGODB_URI=
FRONTEND_ORIGIN_URL=
# Ancien JWT maison, plus utilisé par le middleware actuel
SECRET_TOKEN=

# --- Web (apps/web, préfixe VITE_) ---
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
VITE_BACKEND_URL=

# --- Mobile (apps/mobile, préfixe EXPO_PUBLIC_) ---
EXPO_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
EXPO_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
EXPO_PUBLIC_BASE_URL=
